{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {"api/contact.js": {"maxDuration": 10}},
  "rewrites": [
    {"source": "/styles.css", "destination": "https://raw.githubusercontent.com/Jambovisuaalit/vido-social-frontend/main/styles.css"},
    {"source": "/script.js", "destination": "https://raw.githubusercontent.com/Jambovisuaalit/vido-social-frontend/main/script.js"},
    {"source": "/assets/landing/:path*", "destination": "https://raw.githubusercontent.com/Jambovisuaalit/vido-social-frontend/main/assets/landing/:path*"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"}
      ]
    },
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/(tietosuoja|404)", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/styles.css", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, must-revalidate"}]},
    {"source": "/script.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, must-revalidate"}]},
    {"source": "/assets/landing/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, must-revalidate"}]},
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
